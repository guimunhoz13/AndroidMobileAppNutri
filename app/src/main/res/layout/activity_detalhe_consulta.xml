<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F7F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dados da Consulta"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data da consulta"
            android:textColor="#555555"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtDataConsulta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="DD/MM/AAAA"
            android:inputType="date"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Peso (kg)"
                    android:textColor="#555555"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtPeso"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Ex: 70.5"
                    android:inputType="numberDecimal"
                    android:backgroundTint="#2E7D32" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Altura (m)"
                    android:textColor="#555555"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtAltura"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Ex: 1.70"
                    android:inputType="numberDecimal"
                    android:backgroundTint="#2E7D32" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtIMCResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IMC: --"
            android:textSize="16sp"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:background="#E8F5E9"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Observações"
            android:textColor="#555555"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtObservacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Observações clínicas..."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btnInserir"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Salvar Consulta"
            android:textStyle="bold"
            android:onClick="InserirClique"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAtualizar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Atualizar Consulta"
            android:textStyle="bold"
            android:onClick="AtualizarClique"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExcluir"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Excluir Consulta"
            android:textStyle="bold"
            android:onClick="ExcluirClique"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alimentos da Consulta"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alimento cadastrado"
            android:textColor="#555555"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spnAlimentos"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantidade"
            android:textColor="#555555"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtQuantidade"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ex: 100g"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAddAlimento"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="+ Vincular Alimento à Consulta"
            android:textStyle="bold"
            android:onClick="AddAlimentoClique"
            android:backgroundTint="#F57F17"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <ListView
            android:id="@+id/lsvAlimentos"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:nestedScrollingEnabled="true"
            android:background="#FFFFFF"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp" />

    </LinearLayout>
</ScrollView>