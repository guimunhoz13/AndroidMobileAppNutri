<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F7F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dados do Paciente"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome completo"
            android:textColor="#555555"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtNome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ex: Maria da Silva"
            android:inputType="textPersonName"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data de nascimento"
            android:textColor="#555555"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtDataNascimento"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="DD/MM/AAAA"
            android:inputType="date"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telefone"
            android:textColor="#555555"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtTelefone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="+55 (00) 00000-0000"
            android:inputType="phone"
            android:maxLength="19"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Objetivo nutricional"
            android:textColor="#555555"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: Perda de peso, ganho de massa..."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="22dp" />

        <Button
            android:id="@+id/btnInserir"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Cadastrar Paciente"
            android:textStyle="bold"
            android:onClick="InserirClique"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAtualizar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Atualizar Dados"
            android:textStyle="bold"
            android:onClick="AtualizarClique"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnConsultas"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Ver Consultas"
            android:textStyle="bold"
            android:onClick="ConsultasClique"
            android:backgroundTint="#F57F17"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPlanoAlimentar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Plano Alimentar"
            android:textStyle="bold"
            android:onClick="PlanoAlimentarClique"
            android:backgroundTint="#43A047"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExcluir"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Excluir Paciente"
            android:textStyle="bold"
            android:onClick="ExcluirClique"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>