<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/txtPacienteNome" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="#1B5E20"/>
    <TextView android:id="@+id/txtPacienteTelefone" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#555555"/>
    <TextView android:id="@+id/txtPacienteObjetivo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#388E3C"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginTop="8dp"/>
</LinearLayout>
